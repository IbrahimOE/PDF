# Optional: Firebase-Konfiguration als Umgebungsvariablen (Datei in .env.local umbenennen).
# Alternativ die Werte direkt in src/config/firebase-config.js eintragen.
# Bei Veröffentlichung über Firebase Hosting wird die Konfiguration automatisch geladen.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
